# Server
PORT=3000
# Local dev: one origin per app (3 separate static servers/ports).
# Production: site/admin/espace-client are deployed as subpaths of the SAME
# domain (see README), so this is a single origin there — e.g.
# CORS_ORIGIN=https://vakpon-tours.com
CORS_ORIGIN=http://localhost:5500,http://localhost:5501,http://localhost:5502

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vakpon-tours

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Mail (any SMTP provider works: Gmail app password, Brevo, Resend SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Vakpon Tours <no-reply@vakpontours.com>"
ADMIN_ALERT_EMAIL=vakpontours@gmail.com

# Espace Client URL — linked to from customer emails (welcome, confirmation, status update)
# Production: https://vakpon-tours.com/espace-client/index.html
CLIENT_URL=http://localhost:5502/index.html

# One-time admin account seed (used by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@vakpontours.com
SEED_ADMIN_PASSWORD=change-me-immediately
